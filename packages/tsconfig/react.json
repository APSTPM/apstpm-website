{
  "extends": "./base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@apstpm/ui": ["./packages/ui/src"],
      "@apstpm/ui/*": ["./packages/ui/src/*"],
      "@apstpm/i18n": ["./packages/i18n/src"],
      "@apstpm/i18n/*": ["./packages/i18n/src/*"],
      "@apstpm/utils": ["./packages/utils/src"],
      "@apstpm/utils/*": ["./packages/utils/src/*"]
    }
  }
}
