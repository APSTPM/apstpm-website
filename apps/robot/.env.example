# ==============================================================================
# Supabase Configuration
# ==============================================================================
# 從 Supabase Dashboard > Project Settings > API 獲取
# Project API keys > Project URL 和 anon public

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here

# Service Role Key（僅用於服務器端操作，通常不需要設置）
# SUPABASE_SERVICE_ROLE_KEY=sb_service_your-service-key-here

# ==============================================================================
# Resend (Email Notifications) - Optional
# ==============================================================================
# 從 resend.com 獲取 API Key
# 不設置則跳過郵件發送，不影響其他功能

RESEND_API_KEY=re_your-api-key-here

# ==============================================================================
# Site URL
# ==============================================================================
# 用於郵件中的連結
# 開發環境: http://localhost:3000
# 生產環境: https://your-domain.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
